#!/usr/bin/env bash
# Model-checks .cursor/skills/verify-menu-sync/model/MenuSync.tla with TLC.
# The model's code-fact constants are read from the code, so removing a
# signal or a revision bump in the code turns its constant FALSE and the
# check shows what breaks.
set -euo pipefail

TLA_VERSION=1.8.0
TLA_SHA256=fc6878c603f0fdc18b9fe3e5bf51860cb90ab5b1154e3c371660c036d6bdd63e

# Model bounds. SKILL.md explains what each one covers.
MAX_ITEMS=${MAX_ITEMS:-3}
MAX_OPS=${MAX_OPS:-3}
MAX_LABEL=${MAX_LABEL:-2}

# Properties the current code is known to break, as PROPERTY:BOUND. The
# property must hold with the BOUND constant FALSE and is expected to fail
# with it TRUE. Remove an entry once the code is fixed and the check passes it.
KNOWN_FINDINGS=()

PROPERTIES=(LayoutConverges PropsConverge RevisionsIncrease LabelChangeKeepsMenuOpen)

ONLY=
if [[ ${1:-} == --only ]]; then
  ONLY=${2:?usage: check-menu-sync [--only PROPERTY]}
fi

ROOT=$(git rev-parse --show-toplevel)
SKILL_DIR="$ROOT/.cursor/skills/verify-menu-sync"
OUT="$SKILL_DIR/out"
WORKERS=${TLC_WORKERS:-auto}

die() { echo "error: $*" >&2; exit 2; }

command -v java >/dev/null || die "java not found. Install a JDK 11 or newer (for example: mise exec java@temurin-21 -- $0)."
command -v perl >/dev/null || die "perl not found."

JAR=${TLA2TOOLS_JAR:-"${XDG_CACHE_HOME:-$HOME/.cache}/deedles-tray/tla2tools-$TLA_VERSION.jar"}
if [[ ! -f "$JAR" ]]; then
  mkdir -p "$(dirname "$JAR")"
  echo "downloading tla2tools.jar $TLA_VERSION to $JAR"
  curl -fsSL -o "$JAR.part" "https://github.com/tlaplus/tlaplus/releases/download/v$TLA_VERSION/tla2tools.jar"
  mv "$JAR.part" "$JAR"
fi
if command -v sha256sum >/dev/null; then
  sum=$(sha256sum "$JAR" | cut -d' ' -f1)
else
  sum=$(shasum -a 256 "$JAR" | cut -d' ' -f1)
fi
[[ "$sum" == "$TLA_SHA256" ]] || die "$JAR has sha256 $sum, expected $TLA_SHA256. Delete it and rerun."

# anchor FILE REGEX: TRUE when REGEX (Perl, /s) matches FILE.
anchor() {
  perl -0777 -ne "exit(/$2/s ? 0 : 1)" "$ROOT/$1" && echo TRUE || echo FALSE
}
all() { local v; for v in "$@"; do [[ $v == TRUE ]] || { echo FALSE; return; }; done; echo TRUE; }

BODY='(?:(?!\n\}\n).)*?'
# A statement at the top level of a function body, so the call always runs.
TOP='\n\t[^\t\n][^\n]*'

# Code facts: one regex per model constant. A FALSE means the code no longer
# does it, or the code moved and the regex needs updating. SKILL.md says how
# to tell.
FLAG_NAMES=()
flag() { FLAG_NAMES+=("$1"); printf -v "FLAG_$1" %s "$2"; }
flag RevisionBumps "$(anchor menu.go 'func \(menu \*Menu\) updateLayout\(nodes \.\.\.menuNode\) error \{'"$BODY"'\n\tmenu\.revision\+\+\n'"$BODY"'for _, node := range nodes \{'"$BODY"'"com\.canonical\.dbusmenu\.LayoutUpdated", menu\.revision, id\)')"
flag AddChildSignalsLayout "$(all \
  "$(anchor menuitem.go 'func \(menu \*Menu\) AddChild\('"$BODY$TOP"'updateLayout\(')" \
  "$(anchor menuitem.go 'func \(item \*MenuItem\) AddChild\('"$BODY$TOP"'updateLayout\(')")"
flag RemoveSignalsLayout "$(anchor menuitem.go 'func \(item \*MenuItem\) Remove\(\) error \{'"$BODY$TOP"'updateLayout\(')"
flag AppendSignalsLayout "$(anchor menuitem.go 'func appendChild\('"$BODY$TOP"'updateLayout\(')"
flag MoveBeforeSignalsLayout "$(anchor menuitem.go 'func \(item \*MenuItem\) MoveBefore\('"$BODY$TOP"'updateLayout\(')"
flag SetPropsSignalsProps "$(anchor menuitem.go 'func \(item \*MenuItem\) SetProps\('"$BODY$TOP"'emitPropertiesUpdated\(')"
# Not a model constant itself: LateReply is its negation. TRUE when the
# props-carrying methods write their reply under Menu.m and godbus's own
# reply is switched off for them.
REPLY_UNDER_LOCK=$(all \
  "$(anchor item.go 'func New\('"$BODY"'dbus\.ConnectSessionBus\(dbus\.WithIncomingInterceptor\(claimMenuReplies\)\)')" \
  "$(anchor dbusmenu.go 'func claimMenuReplies\('"$BODY"'msg\.Flags \|= dbus\.FlagNoReplyExpected \| flagReplyOwed')" \
  "$(anchor dbusmenu.go 'func \(menu \*dbusmenu\) send\('"$BODY"'conn\.Send\(')" \
  "$(anchor dbusmenu.go 'func \(menu \*dbusmenu\) GetLayout\(call dbus\.Message,'"$BODY"'\n\treturn reply2\(menu, call, ')" \
  "$(anchor dbusmenu.go 'func \(menu \*dbusmenu\) GetGroupProperties\(call dbus\.Message,'"$BODY"'\n\treturn reply\(menu, call, ')")
LATE_REPLY=$([[ $REPLY_UNDER_LOCK == TRUE ]] && echo FALSE || echo TRUE)
flag SetPropsSignalsLayout "$(anchor menuitem.go 'func \(item \*MenuItem\) SetProps\('"$BODY"'updateLayout\(')"

# Assumptions the model's steps rest on. Each must hold, or the model no
# longer describes the code.
ASSUMPTIONS=()
assume() { [[ $2 == TRUE ]] || ASSUMPTIONS+=("$1"); }
for fn in 'func \(menu \*Menu\) AddChild\(' 'func \(item \*MenuItem\) AddChild\(' 'func \(item \*MenuItem\) Remove\(\) error \{' 'func appendChild\(' 'func \(item \*MenuItem\) MoveBefore\(' 'func \(item \*MenuItem\) SetProps\('; do
  assume "menu lock first in ${fn//\\/}" "$(anchor menuitem.go "$fn"'[^\n]*\n\tdefer (?:item\.)?menu\.lock\(\)\(\)\n')"
done
assume "GetLayout holds menu.m while it builds the layout" "$(anchor dbusmenu.go 'func \(menu \*dbusmenu\) GetLayout\('"$BODY"'menu\.m\.Lock\(\)\n\tdefer menu\.m\.Unlock\(\)'"$BODY"'menu\.buildLayout\(parent, recursionDepth, propertyNames\)')"
assume "buildLayout copies every property into the reply" "$(anchor dbusmenu.go 'func \(menu \*dbusmenu\) buildLayout\('"$BODY"'Properties: mapSlice\(item\.props, nil\)')"
assume "updateLayout emits LayoutUpdated for each node it is given" "$(anchor menu.go 'for _, node := range nodes \{\s*id := node\.getID\(\)\s*err := menu\.item\.conn\.Emit\(menuPath, "com\.canonical\.dbusmenu\.LayoutUpdated"')"

echo "code facts (model constants):"
printf '  %-25s %s\n' LateReply "$LATE_REPLY"
for k in "${FLAG_NAMES[@]}"; do
  v="FLAG_$k"; printf '  %-25s %s\n' "$k" "${!v}"
done
if (( ${#ASSUMPTIONS[@]} > 0 )); then
  echo "MODEL STALE: these steps no longer match the code, so a result would not describe it:"
  printf '  %s\n' "${ASSUMPTIONS[@]}"
  exit 1
fi

rm -rf "$OUT" && mkdir -p "$OUT"
cp "$SKILL_DIR/model/MenuSync.tla" "$OUT/"

# write_cfg NAME LATE_REPLY INVARIANTS...
write_cfg() {
  local name=$1 late=$2; shift 2
  {
    echo "SPECIFICATION Spec"
    echo "CONSTANTS"
    echo "  MaxItems = $MAX_ITEMS"
    echo "  MaxOps = $MAX_OPS"
    echo "  MaxLabel = $MAX_LABEL"
    echo "  LateReply = $late"
    for k in "${FLAG_NAMES[@]}"; do v="FLAG_$k"; echo "  $k = ${!v}"; done
    echo "CHECK_DEADLOCK FALSE"
    echo "INVARIANT TypeOK $*"
  } >"$OUT/$name.cfg"
}

# run NAME LATE_REPLY INVARIANTS...: prints the violated invariant, "none",
# or "tool-error".
run() {
  local name=$1; shift
  write_cfg "$name" "$@"
  (cd "$OUT" && java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -config "$name.cfg" \
    -workers "$WORKERS" -metadir "$OUT/meta-$name" -nowarning MenuSync.tla) >"$OUT/$name.out" 2>&1 || true
  if grep -q '^Model checking completed. No error has been found.' "$OUT/$name.out"; then
    echo none
  elif v=$(grep -oE '^Error: Invariant [A-Za-z]+ is violated' "$OUT/$name.out" | awk '{print $3}'); [[ -n $v ]]; then
    echo "$v"
  else
    echo tool-error
  fi
}

if [[ -n $ONLY ]]; then KNOWN_FINDINGS=(); fi
is_known() { local x; for x in "${KNOWN_FINDINGS[@]}"; do [[ ${x%%:*} == "$1" ]] && return 0; done; return 1; }

expected=()
for p in "${PROPERTIES[@]}"; do is_known "$p" || expected+=("$p"); done
[[ -n $ONLY ]] && expected=("$ONLY")

status=0
start=$SECONDS
result=$(run main "$LATE_REPLY" "${expected[@]}")
case $result in
  none) echo "PASS  ${expected[*]}" ;;
  tool-error) echo "TOOL ERROR, see $OUT/main.out"; status=2 ;;
  *) echo "FAIL  $result (counterexample: $OUT/main.out)"; status=1 ;;
esac

for entry in "${KNOWN_FINDINGS[@]}"; do
  f=${entry%%:*} bound=${entry#*:}
  r=$(run "$f-without-$bound" FALSE "$f")
  case $r in
    none) echo "PASS  $f with $bound FALSE" ;;
    tool-error) echo "TOOL ERROR, see $OUT/$f-without-$bound.out"; status=2 ;;
    *) echo "FAIL  $r with $bound FALSE (counterexample: $OUT/$f-without-$bound.out)"; [[ $status == 0 ]] && status=1 ;;
  esac
  r=$(run "$f" TRUE "$f")
  case $r in
    "$f") echo "KNOWN FINDING still present: $f with $bound TRUE (counterexample: $OUT/$f.out)" ;;
    none) echo "FIXED? $f now passes with $bound TRUE. Confirm the fix with a test, then remove it from KNOWN_FINDINGS and the findings in SKILL.md."; status=1 ;;
    tool-error) echo "TOOL ERROR, see $OUT/$f.out"; status=2 ;;
    *) echo "FAIL  $r while checking $f (counterexample: $OUT/$f.out)"; [[ $status == 0 ]] && status=1 ;;
  esac
done
# The model must still find the race without the fix, or a pass above
# proves nothing about it.
if [[ -z $ONLY ]]; then
  r=$(run PropsConverge-with-LateReply TRUE PropsConverge)
  case $r in
    PropsConverge) echo "PASS  PropsConverge fails with LateReply TRUE, as it must" ;;
    none) echo "FAIL  PropsConverge passes with LateReply TRUE, so the model no longer sees the race"; status=1 ;;
    *) echo "TOOL ERROR, see $OUT/PropsConverge-with-LateReply.out"; status=2 ;;
  esac
fi
echo "model checked in $((SECONDS - start))s"

# Coverage drift: covered code changed since the sync commit in SKILL.md.
sync=$(sed -n 's/^Sync commit: `\([0-9a-f]*\)`.*/\1/p' "$SKILL_DIR/SKILL.md")
covered=$(sed -n 's/^- `\([^`]*\)`:.*/\1/p' "$SKILL_DIR/SKILL.md" | sort -u)
if [[ -n $sync ]] && git -C "$ROOT" cat-file -e "$sync^{commit}" 2>/dev/null; then
  # shellcheck disable=SC2086
  drift=$(cd "$ROOT" && git diff --name-only "$sync" -- $covered)
  if [[ -n $drift ]]; then
    echo "covered code changed since sync commit $sync, so recheck the model against it:"
    echo "$drift" | sed 's/^/  /'
  fi
else
  echo "warning: sync commit '$sync' from SKILL.md is not in this clone; cannot check coverage drift."
fi

exit $status
